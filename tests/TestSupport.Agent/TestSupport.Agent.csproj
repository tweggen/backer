<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TestSupport.Agent</RootNamespace>
  </PropertyGroup>

  <!--
    The agent-side harness, shared by tests/BackerAgent.IntegrationTests (agent
    alone, substitute API) and tests/Backer.E2ETests (agent joined to a real
    in-memory API).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.8" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BackerAgent\BackerAgent.csproj" />
    <ProjectReference Include="..\TestSupport.RClone\TestSupport.RClone.csproj" />
  </ItemGroup>

</Project>
